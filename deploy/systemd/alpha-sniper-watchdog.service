[Unit]
Description=Alpha Sniper - Watchdog health check
Documentation=https://github.com/mrm88/BIOTECH_SNIPER

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/alpha_sniper/repo
EnvironmentFile=/root/alpha_sniper/.env
ExecStart=/root/alpha_sniper/repo/.venv/bin/python -m biotech_sniper.watchdog
StandardOutput=journal
StandardError=journal
TimeoutStartSec=2min
Nice=10

[Install]
WantedBy=multi-user.target
