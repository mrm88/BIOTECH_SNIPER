# Biotech Sniper — required environment variables.
#
# Copy this file to ``.env`` (which is gitignored) and fill in real values
# locally. On the VPS the deployed env file lives at
# /root/alpha_sniper/.env (mode 600, root-owned) — never inside the repo.
#
# This file lists key NAMES only. NEVER commit a real secret here.

# Project home (absolute path to the repo checkout). Resolved by paths.py.
BIOTECH_SNIPER_HOME=

# --- LLM providers ---------------------------------------------------------
# xAI / Grok-4 — fast-tier ranking pass over the universe.
XAI_API_KEY=
# Anthropic / Claude — deep-tier science reasoning.
ANTHROPIC_API_KEY=
# Google Gemini 2.5 Pro — deep-tier science reasoning (ensemble partner).
GEMINI_API_KEY=
# Perplexity Sonar — Reading-B Stage-2 fourth ensemble provider. Tier 1
# account (≥ $50 credits, 150 RPM on `sonar`). NEVER commit a real key
# here; the value is provisioned only in /root/alpha_sniper/.env on the
# VPS (mode 600, root-owned). Read via config.get_perplexity_api_key().
PERPLEXITY_API_KEY=

# --- Alpaca (paper trading only — M3) --------------------------------------
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# Hard-coded paper endpoint. Live trading is hard-blocked behind LIVE_MODE
# AND the ``i-understand-this-trades-real-money`` confirmation marker file.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Live-trading guardrail. Default 0 (paper only). Workers MUST NOT change.
LIVE_MODE=0
